*{box-sizing:border-box}body{margin:0;font-family:system-ui,Arial;background:#f5f5f5;color:#222}.login{max-width:420px;margin:12vh auto;background:#fff;padding:30px;border-radius:20px}.login form,.form{display:grid;gap:14px}label{font-weight:800}input,select{width:100%;padding:12px;border:1px solid #ccc;border-radius:10px;margin-top:6px;font-size:16px}button{border:0;border-radius:10px;padding:12px 16px;font-weight:800;background:#111;color:#fff}.err{background:#fee2e2;padding:10px;border-radius:10px;margin-bottom:15px}.adminTop{background:#111;color:#fff;padding:16px 22px;display:flex;justify-content:space-between}.wrap{max-width:1100px;margin:20px auto;padding:0 15px}.nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}.nav a{padding:10px 14px;background:#fff;border-radius:10px;color:#111;text-decoration:none;font-weight:800}.card{background:#fff;border-radius:16px;padding:18px;margin-bottom:16px}table{width:100%;border-collapse:collapse}th,td{padding:10px;border-bottom:1px solid #eee;text-align:left}.muted{color:#777}.inline{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.danger{background:#a00}.ok{background:#176b3a}
